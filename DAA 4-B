#include <iostream>
#include <fstream>
using namespace std;

#define MAX 100
#define INF 9999

void dijkstra(int graph[MAX][MAX], int n, int source, int destination,
              ofstream &fout) {

    int dist[MAX];
    bool visited[MAX];
    int parent[MAX];

    for (int i = 0; i < n; i++) {
        dist[i] = INF;
        visited[i] = false;
        parent[i] = -1;
    }

    dist[source] = 0;

    for (int count = 0; count < n - 1; count++) {

        int u = -1;

        for (int i = 0; i < n; i++) {
            if (!visited[i] &&
                (u == -1 || dist[i] < dist[u])) {
                u = i;
            }
        }

        if (u == -1 || dist[u] == INF)
            break;

        visited[u] = true;

        for (int v = 0; v < n; v++) {

            if (!visited[v] &&
                graph[u][v] != 0 &&
                dist[u] + graph[u][v] < dist[v]) {

                dist[v] = dist[u] + graph[u][v];
                parent[v] = u;
            }
        }
    }

    fout << "Flight Route Planner\n";
    fout << "Source Airport: " << source << endl;
    fout << "Destination Airport: " << destination << endl;
    fout << "Shortest Travel Time: " << dist[destination]
         << " hours" << endl;

    if (dist[destination] == INF) {
        fout << "No route available.\n";
        return;
    }

    int path[MAX];
    int count = 0;
    int current = destination;

    while (current != -1) {
        path[count++] = current;
        current = parent[current];
    }

    fout << "Quickest Route: ";

    for (int i = count - 1; i >= 0; i--) {
        fout << path[i];

        if (i != 0)
            fout << " -> ";
    }

    fout << endl;
}

int main() {

    ifstream fin("input.txt");
    ofstream fout("output.txt");

    if (!fin) {
        cout << "Error: input.txt not found.\n";
        return 1;
    }

    if (!fout) {
        cout << "Error: output.txt could not be created.\n";
        return 1;
    }

    int n, e;

    fin >> n >> e;

    int graph[MAX][MAX] = {0};

    for (int i = 0; i < e; i++) {

        int u, v, w;

        fin >> u >> v >> w;

        graph[u][v] = w;
        graph[v][u] = w;
    }

    int source, destination;

    fin >> source >> destination;

    dijkstra(graph, n, source, destination, fout);

    cout << "Flight route calculation completed.\n";
    cout << "Check output.txt for the quickest route.\n";

    fin.close();
    fout.close();

    return 0;
}
